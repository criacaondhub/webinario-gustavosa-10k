# Copie para api/.env para rodar localmente (npm run dev).
# Na VPS os valores vêm de Docker secrets (ver api/README.md) — este arquivo não vai para o git.
DATABASE_URL=postgres://usuario:senha@localhost:5432/protocolo10k
PORT=3001
# DATABASE_SSL=true

# Painel /dash — usuário único da agência
DASH_USER=nd-protocolo
# Gere com: npm run hash-password -- "a senha"   (nunca coloque a senha em texto aqui)
DASH_PASSWORD_HASH=
# String aleatória longa. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASH_SESSION_SECRET=
